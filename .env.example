# E-posta yapılandırması — kopyala: copy .env.example .env
# Gmail: IMAP_HOST=imap.gmail.com, SMTP_HOST=smtp.gmail.com, App Password gerekli
# Outlook: IMAP_HOST=outlook.office365.com, SMTP_HOST=smtp.office365.com

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Varsayılan klasör
EMAIL_DEFAULT_FOLDER=INBOX

# İmza: kodda gömülü default vardır (asistan imzası).
# Değiştirmek için buraya yaz (markdown, \n ile çok satır). Kapatmak için: off
#EMAIL_SIGNATURE=

# Trigger konusu (check_promt tool'u bunu izler)
EMAIL_TRIGGER_SUBJECT=PROMT
