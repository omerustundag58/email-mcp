# E-posta yapılandırması — kopyala: copy .env.example .env
# Gmail: IMAP_HOST=imap.gmail.com, SMTP_HOST=smtp.gmail.com, App Password gerekli
# Outlook: IMAP_HOST=outlook.office365.com, SMTP_HOST=smtp.office365.com

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true

# Varsayılan klasör
EMAIL_DEFAULT_FOLDER=INBOX

# İmza (markdown destekler, \n ile çok satır). Tüm gönderilere eklenir.
EMAIL_SIGNATURE=Bu e-posta **OpenCode asistanı** tarafından gönderildi 🤖\n[email-mcp](https://github.com/omerustundag58/email-mcp)
